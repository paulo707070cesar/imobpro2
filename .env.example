# Supabase Config (Obrigatórias para conectar ao banco em produção)
# Obtenha em: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-anon-publica-do-supabase"

# Opcional / Backend
# GEMINI_API_KEY: Usado caso habilite recursos de IA no backend
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL do seu domínio na Hostinger (ex: https://seudominio.com.br)
APP_URL="https://seudominio.com.br"

